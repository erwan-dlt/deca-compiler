# Do not version generated files.
/target

# These are IDE-specific files. We version pom.xml, and rely on IDE
# integration with maven (or with maven's generation of IDE files like
# mvn eclipse:eclipse).
.classpath
.project
.metadata
.settings

# Compiler output and local tooling
*.ass
*.out
*.log
*.class
.DS_Store
.idea/
.vscode/
*.swp
.~lock.*
