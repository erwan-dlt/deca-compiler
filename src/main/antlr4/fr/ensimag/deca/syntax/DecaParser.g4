parser grammar DecaParser;

options {
    // Default language but name it anyway
    //
    language  = Java;

    // Use a superclass to implement all helper
    // methods, instance variables and overrides
    // of ANTLR default methods, such as error
    // handling.
    //
    superClass = AbstractDecaParser;

    // Use the vocabulary generated by the accompanying
    // lexer. Maven knows how to work out the relationship
    // between the lexer and parser and will build the
    // lexer before the parser. It will also rebuild the
    // parser if the lexer changes.
    //
    tokenVocab = DecaLexer;

}

// which packages should be imported?
@header {
    import fr.ensimag.deca.tree.*;
    import fr.ensimag.deca.tools.SymbolTable;
    import java.io.PrintStream;
}

@members {
    @Override
    protected AbstractProgram parseProgram() {
        return prog().tree;
    }
}

prog returns[AbstractProgram tree]
    : list_classes main EOF {
            assert($list_classes.tree != null);
            assert($main.tree != null);
            $tree = new Program($list_classes.tree, $main.tree);
            setLocation($tree, $main.start);
        }
    ;

main returns[AbstractMain tree]
    : /* epsilon */ {
            $tree = new EmptyMain();
        }
    | block {
            assert($block.decls != null);
            assert($block.insts != null);
            $tree = new Main($block.decls, $block.insts);
            setLocation($tree, $block.start);
        }
    ;

block returns[ListDeclVar decls, ListInst insts]
    : LBRACE list_decl list_inst RBRACE {
            assert($list_decl.tree != null);
            assert($list_inst.tree != null);
            $decls = $list_decl.tree;
            $insts = $list_inst.tree;
        }
    ;

list_decl returns[ListDeclVar tree]
@init {
    $tree = new ListDeclVar();
}
    : (decl_var_set[$tree] {  //ajoute a la liste en passant en argument
        assert(!$tree.isEmpty());
      })*
    ;

decl_var_set[ListDeclVar l]
    : t=type {
        assert($t.tree != null);
    }
      list_decl_var[$l, $t.tree] {  //appelle la sous règle qui a ajouter a la liste
        assert(!$l.isEmpty()); // Vérifie qu'au moins une variable a été déclarée
      }
      SEMICOLON { //fin de la règle après point virgule
      }
    ;


list_decl_var[ListDeclVar l, AbstractIdentifier t]
    : dv1=decl_var[$t] {
        // Ajout de la première déclaration de variable à la liste
        assert($dv1.tree != null);
        $l.add($dv1.tree);
    }
    (COMMA dv2=decl_var[$t] {
        // Ajout des déclarations supplémentaires après les virgules
        assert($dv2.tree != null);
        $l.add($dv2.tree);
    })*
    ;

decl_var[AbstractIdentifier t] returns [AbstractDeclVar tree]
    : i=ident {
        assert($i.tree != null);

        NoInitialization noInit = new NoInitialization();
        setLocation(noInit, $i.start);

        $tree = new DeclVar($t, $i.tree, noInit);
        setLocation($tree, $i.start);
      }
      (EQ e=expr {
        assert($e.tree != null);

        Initialization init = new Initialization($e.tree);
        setLocation(init, $e.start);

        $tree = new DeclVar($t, $i.tree, init);
        setLocation($tree, $i.start);
      }
      )?
    ;
list_inst returns[ListInst tree]
@init {
    $tree = new ListInst();
}
    : (i=inst {
        // Ajoute chaque instruction à la liste
        if($i.tree != null){
            $tree.add($i.tree);
        }
      })*
    ;

inst returns[AbstractInst tree]
    : e1=expr SEMICOLON {
        assert($e1.tree != null);
        $tree = $e1.tree;
    }
    | SEMICOLON {
        // Instruction vide (un point-virgule seul) on ne fait rien on renvoie null
        $tree = new NoOperation();
        setLocation($tree, $start);
    }
    | PRINT LPAREN list_expr RPAREN SEMICOLON {
        assert($list_expr.tree != null);
        $tree = new Print(false, $list_expr.tree); // Affichage standard
        setLocation($tree, $start);
    }
    | PRINTX LPAREN list_expr RPAREN SEMICOLON {
        assert($list_expr.tree != null);
        $tree = new Print(true, $list_expr.tree); // Affichage en hexadécimal
        setLocation($tree, $start);
    }
    | PRINTLN LPAREN list_expr RPAREN SEMICOLON {
        assert($list_expr.tree != null);
        $tree = new Println(false, $list_expr.tree); // Affichage avec saut de ligne
        setLocation($tree, $start);
    }
    | PRINTLNX LPAREN list_expr RPAREN SEMICOLON {
        assert($list_expr.tree != null);
        $tree = new Println(true, $list_expr.tree); // Affichage avec saut de ligne en hexa
        setLocation($tree, $start);
    }
    | if_then_else {
        assert($if_then_else.tree != null);
        $tree = $if_then_else.tree;
    }
    | WHILE LPAREN condition=expr RPAREN LBRACE body=list_inst RBRACE {
        assert($condition.tree != null);
        assert($body.tree != null);
        $tree = new While($condition.tree, $body.tree);
        setLocation($tree, $start);
    }
    | RETURN e1=expr SEMICOLON {
        assert($e1.tree != null);
        $tree = new Return($e1.tree);
        setLocation($tree, $RETURN);
    }
    ;

if_then_else returns [IfThenElse tree]
@init {
    IfThenElse current = null; //utile pour imbriquer les else dans les if
    ListInst empty = new ListInst();  // pour initialiser les elseBlock à vide
}
    : IF LPAREN c=expr RPAREN LBRACE li_if=list_inst RBRACE {
        $tree = new IfThenElse($c.tree, $li_if.tree, empty);
        setLocation($tree, $start);
        current = $tree;
    }
    (
      ELSE IF LPAREN ec=expr RPAREN LBRACE eLi=list_inst RBRACE {
        IfThenElse sub = new IfThenElse($ec.tree, $eLi.tree, new ListInst());
        setLocation(sub, $ELSE);
        ListInst elseList = new ListInst();
        elseList.add(sub);
        current.setElse(elseList);  //methode ajoutée a IfThenElse pour imbriquer les branches (if et else)
        current = sub; // On continue avec sub comme noeud courant
      }
    )*
    (
      ELSE LBRACE li_else=list_inst RBRACE {
         current.setElse($li_else.tree);
         setLocation(current, $ELSE);
      }
    )?
    ;

list_expr returns[ListExpr tree]
@init {
    // Initialisation même si liste vide
    $tree = new ListExpr();
}
    : (e1=expr {
            assert($e1.tree != null);
            // Crée un noeud pour la première expression
            $tree.add($e1.tree);
        }
       (COMMA e2=expr {
            assert($e2.tree != null);
            // Ajoute les expressions supplémentaires à la liste
            $tree.add($e2.tree);
        }
       )*
    )?
    ;

expr returns[AbstractExpr tree]
    : assign_expr {
            assert($assign_expr.tree != null);
            $tree=$assign_expr.tree;
        }
    ;

assign_expr returns [AbstractExpr tree]
    : e=or_expr (
        /* Condition : e doit être un LVALUE pour permettre une assignation */
        {
            if (!($e.tree instanceof AbstractLValue)) {
                System.out.println("erreur lvalue");
                throw new InvalidLValue(this, $ctx); // Lève une erreur si e n'est pas un LVALUE
            }
        }
        EQ e2=assign_expr {
            assert($e.tree != null);
            assert($e2.tree != null);
            $tree = new Assign(($e.tree instanceof AbstractLValue) ? (AbstractLValue) $e.tree : null, $e2.tree);
            setLocation($tree, $e2.start);
        }
      | /* epsilon */ {
            assert($e.tree != null);
            // Pas d'assignation, retourne l'expression simple
            $tree = $e.tree;
        }
      )
    ;

or_expr returns [AbstractExpr tree]
    : e=and_expr {
            assert($e.tree != null);
            $tree = $e.tree;
            setLocation($tree, $e.start);
        }
    | e1=or_expr OROR e2=and_expr {
            assert($e1.tree != null);
            assert($e2.tree != null);
            $tree = new Or($e1.tree, $e2.tree);  // Crée un noeud logique "OU" avec e1 et e2 comme enfants
            setLocation($tree, $e1.start);
        }
    ;


and_expr returns[AbstractExpr tree]
    : e=eq_neq_expr {
            assert($e.tree != null);
            $tree = $e.tree;
            setLocation($tree, $e.start);
        }
    |  e1=and_expr ANDAND e2=eq_neq_expr {
            assert($e1.tree != null);                         
            assert($e2.tree != null);
            $tree = new And($e1.tree, $e2.tree);
            setLocation($tree, $e1.start);
        }
    ;

eq_neq_expr returns[AbstractExpr tree]
    : e=inequality_expr {
            assert($e.tree != null);
            $tree = $e.tree;
            setLocation($tree, $e.start);
        }
    | e1=eq_neq_expr EQEQ e2=inequality_expr {
            assert($e1.tree != null);
            assert($e2.tree != null);
            $tree = new Equals($e1.tree, $e2.tree); // ==
            setLocation($tree, $e1.start);
        }
    | e1=eq_neq_expr NOTEQ e2=inequality_expr {
            assert($e1.tree != null);
            assert($e2.tree != null);
            $tree = new NotEquals($e1.tree, $e2.tree); // !=
            setLocation($tree, $e1.start);
        }
    ;


inequality_expr returns[AbstractExpr tree]
    : e=sum_expr {
            assert($e.tree != null);
            $tree = $e.tree;
            setLocation($tree, $e.start);
        }
    | e1=inequality_expr LTEQ e2=sum_expr {
            assert($e1.tree != null);
            assert($e2.tree != null);
            $tree = new LowerOrEqual($e1.tree, $e2.tree); //<=
            setLocation($tree, $e1.start);
        }
    | e1=inequality_expr GTEQ e2=sum_expr {
            assert($e1.tree != null);
            assert($e2.tree != null);
            $tree = new GreaterOrEqual($e1.tree, $e2.tree); //>=
            setLocation($tree, $e1.start);
        }
    | e1=inequality_expr GT e2=sum_expr {
            assert($e1.tree != null);
            assert($e2.tree != null);
            $tree = new Greater($e1.tree, $e2.tree);  //>
            setLocation($tree, $e1.start);
        }
    | e1=inequality_expr LT e2=sum_expr {
            assert($e1.tree != null);
            assert($e2.tree != null);
            $tree = new Lower($e1.tree, $e2.tree); //<
            setLocation($tree, $e1.start);
        }
    | e1=inequality_expr INSTANCEOF type {
            assert($e1.tree != null);
            assert($type.tree != null);
            $tree = new InstanceOf($e1.tree, $type.tree); //instanceof
        }
    ;


sum_expr returns[AbstractExpr tree]
    : e=mult_expr {
            assert($e.tree != null);
            $tree = $e.tree;
        }
    | e1=sum_expr PLUS e2=mult_expr {
            assert($e1.tree != null);
            assert($e2.tree != null);
            $tree = new Plus($e1.tree, $e2.tree);  //+
            setLocation($tree, $e2.start);
        }
    | e1=sum_expr MINUS e2=mult_expr {
            assert($e1.tree != null);
            assert($e2.tree != null);
            $tree = new Minus($e1.tree, $e2.tree); //-
            setLocation($tree, $e2.start);
        }
    ;

mult_expr returns [AbstractExpr tree]
    : e=unary_expr {
            assert($e.tree != null);
            $tree = $e.tree;
        }
    | e1=mult_expr STAR e2=unary_expr {
            assert($e1.tree != null);
            assert($e2.tree != null);
            $tree = new Multiply($e1.tree, $e2.tree); // *
            setLocation($tree, $e1.start);
        }
    | e1=mult_expr DIV e2=unary_expr {
            assert($e1.tree != null);
            assert($e2.tree != null);
            $tree = new Divide($e1.tree, $e2.tree); // /
            setLocation($tree, $e1.start);
        }
    | e1=mult_expr MOD e2=unary_expr {
            assert($e1.tree != null);
            assert($e2.tree != null);
            $tree = new Modulo($e1.tree, $e2.tree); // %
            setLocation($tree, $e1.start);
        }
    ;

unary_expr returns[AbstractExpr tree] 
    : op=MINUS e=unary_expr {
            assert($e.tree != null);
            $tree = new UnaryMinus($e.tree); // unary -
            setLocation($tree, $e.start);
        }
    | op=NOT e=unary_expr {
            assert($e.tree != null);
            $tree = new Not($e.tree); // unary NOT
            setLocation($tree, $e.start);
        }
    | select_expr {
            assert($select_expr.tree != null);
            $tree = $select_expr.tree;
        }
    ;

select_expr returns [AbstractExpr tree]
    : e=primary_expr {
        assert($e.tree != null);
        $tree = $e.tree;
    }
    | e1=select_expr DOT i=ident {
          assert($e1.tree != null);
          assert($i.tree != null);

          // Par défaut, c'est un accès au champ : e1.i
          $tree = new AccessField($e1.tree, $i.tree);
          setLocation($tree, $e1.start);
        }
        (
          LPAREN args=list_expr RPAREN {
              assert($args.tree != null);
              $tree = new MethodCall($e1.tree, $i.tree, $args.tree);
              setLocation($tree, $i.start);
          }
          | /* epsilon */ { /* on ne change pas $tree, c'est AccessField */ }
        )
    ;



primary_expr returns[AbstractExpr tree]
    : ident {
            assert($ident.tree != null);
            $tree = $ident.tree;
        }
    | m=ident LPAREN args=list_expr RPAREN {
        assert($m.tree != null);
        assert($args.tree != null);
        $tree = new MethodCall(null, $m.tree, $args.tree);
        setLocation($tree, $m.start);
    }
    | LPAREN e=expr RPAREN {
            assert($e.tree != null);
            $tree = $e.tree;
        }
    | READINT LPAREN RPAREN {
            // Lecture d'entier
            $tree = new ReadInt();
            setLocation($tree, $start);
        }
    | READFLOAT LPAREN RPAREN {
            // Lecture de flottant
            $tree = new ReadFloat();
            setLocation($tree, $start);
        }
    | NEW ident LPAREN RPAREN {
            assert($ident.tree != null);
            // Instanciation d'objet
            $tree=new New($ident.tree);
            setLocation($tree, $start);
        }
    | cast=LPAREN t=type RPAREN LPAREN e=expr RPAREN {
            assert($t.tree != null);
            assert($e.tree != null);

            $tree = new Cast($t.tree, $e.tree);
        }
    | literal {
            assert($literal.tree != null);
            $tree = $literal.tree;
        }
    ;

type returns[AbstractIdentifier tree]
    : ident {
            assert($ident.tree != null);
            $tree=$ident.tree;
        }
    ;

literal returns[AbstractExpr tree]
    : it=INT {
        //transforme la chaine de carac en int
        $tree = new IntLiteral(parseIntegerLiteral($it));
        setLocation($tree, $it);
    }
    | fd=FLOAT {
        //transforme la chaine de carac en float
        $tree = new FloatLiteral(parseFloatLiteral($fd));
        setLocation($tree, $fd);
    }
    | STRING {
        $tree = new StringLiteral(decodeString($STRING.getText()));
        setLocation($tree, $STRING);
    }
    | TRUE {
        $tree = new BooleanLiteral(true);
        setLocation($tree, $TRUE);
    }
    | FALSE {
        $tree = new BooleanLiteral(false);
        setLocation($tree, $FALSE);
    }
    | THIS {
        $tree = new ThisLiteral();
        setLocation($tree, $THIS);
    }
    | NULL {
        $tree = new NullLiteral();
        setLocation($tree, $NULL);
    }
    ;

ident returns[AbstractIdentifier tree] 
    : IDENT {
        assert($IDENT != null);
        // Crée un nouvel identifiant abstrait avec le texte et la position de l'IDENT
        SymbolTable symbolTable = new SymbolTable();  // Instanciation temporaire de SymbolTable
        $tree = new Identifier(symbolTable.create($IDENT.getText()));  // Utilise SymbolTable pour créer un symbole
        setLocation($tree, $IDENT);  // Set l'emplacement pour le débogage ou d'autres usages
    }
    ;


/****     Class related rules     ****/

list_classes returns[ListDeclClass tree] 
@init {
    // initialisation de la liste d'arbres
    $tree = new ListDeclClass();
    setLocation($tree, $start);
}
    : (c1=class_decl {
          // on ajoute chaque déclaration de classe à la liste
          assert($c1.tree != null);
          $tree.add($c1.tree);
          setLocation($tree, $c1.start);
      }
    )*
    ;


class_decl returns[AbstractDeclClass tree]
    : CLASS name=ident superclass=class_extension LBRACE body=class_body RBRACE {
        assert($name.tree != null);
        assert($body.fields != null);
        assert($body.methods != null);
        
        // Choix du constructeur selon la présence de superclasse
        if ($superclass.tree != null) {
            $tree = new DeclClass($name.tree, $superclass.tree, $body.fields, $body.methods);
        } else {
            $tree = new DeclClass($name.tree, $body.fields, $body.methods);
        }
        setLocation($tree, $name.start);
    }
    ;

class_extension returns[AbstractIdentifier tree]
    : EXTENDS name=ident {
        assert($name.tree != null);
        $tree = $name.tree;
        setLocation($tree, $name.start);
    }
    | /* epsilon */ {
        // Pas de superclasse, retourne null et donc aiguille sur le constructeur de declCLass
        $tree = null;
    }
    ;

class_body returns[ListDeclField fields, ListDeclMethod methods]
@init {
    $fields = new ListDeclField();
    $methods = new ListDeclMethod();
    setLocation($fields, $start);
    setLocation($methods, $start);
}
    : (decl_field_set {
          $fields.addAll($decl_field_set.tree);
          setLocation($fields, $decl_field_set.start);
      }
    | decl_method {
          $methods.add($decl_method.tree);
          setLocation($methods, $decl_method.start);
      }
    | ASM LPAREN code=multi_line_string RPAREN SEMICOLON {
          $methods.add(new DeclMethodAsm(null, null, new ListDeclParam(), $code.text));
          setLocation($methods, $ASM);
      }
    )*
    ;


decl_field_set returns[ListDeclField tree]
@init {
    $tree = new ListDeclField();
    setLocation($tree, $start);
}
    : v=visibility t=type {
        assert($t.tree != null); // Assurez-vous que `type` retourne une valeur valide
        AbstractIdentifier typeTree = $t.tree; // Variable intermédiaire
    }
      list_decl_field[typeTree] SEMICOLON {
        assert($list_decl_field.tree != null);

        // Ajout des champs avec leur visibilité et type
        for (AbstractDeclField field : $list_decl_field.tree) {
            field.setVisibility($v.value); // Applique la visibilité
            $tree.add(field);
        }
        setLocation($tree, $v.start);
    }
    ;


visibility returns[Visibility value]
    : /* epsilon */ {
        // par défaut le constructeur du champ met visibility a public
    }
    | PROTECTED {
        $value = Visibility.PROTECTED;
    }
    ;


list_decl_field[AbstractIdentifier t] returns[ListDeclField tree]
@init {
    $tree = new ListDeclField();
    setLocation($tree, $start);
}
    : dv1=decl_field[t] {
        assert($dv1.tree != null);
        $tree.add($dv1.tree); // ajoute la première déclaration à la liste
        setLocation($tree, $dv1.start);
    }
    (COMMA dv2=decl_field[t] {
        assert($dv2.tree != null);
        $tree.add($dv2.tree); // ajoute chaque déclaration supplémentaire à la liste
        setLocation($tree, $dv2.start);
    })*
    ;


decl_field[AbstractIdentifier t] returns[AbstractDeclField tree]
    : i=ident {
        // validation de l'identifiant du champ
        assert($i.tree != null);
        NoInitialization noInit = new NoInitialization();
        setLocation(noInit, $i.start);
        $tree = new DeclField($t,$i.tree, noInit);
        setLocation($tree, $i.start);
    }
    (EQ e=expr {
        // validation de l'expression d'initialisation
        assert($e.tree != null);
        Initialization init = new Initialization($e.tree);
        setLocation(init, $e.start);
        $tree = new DeclField($t,$i.tree, init);
        setLocation($tree, $e.start);
    })?
    ;

decl_method returns[AbstractDeclMethod tree]
    : t=type name=ident LPAREN params=list_params RPAREN 
      (body=block {
          assert($t.tree != null);
          assert($name.tree != null);
          assert($params.tree != null);
          assert($body.decls != null);
          assert($body.insts != null);

          $tree = new DeclMethod($t.tree, $name.tree, $params.tree,$body.decls,$body.insts);
          setLocation($tree, $t.start);
      }
      | ASM LPAREN code=multi_line_string RPAREN SEMICOLON {
          assert($t.tree != null);
          assert($name.tree != null);
          assert($code.text != null);

          $tree = new DeclMethodAsm($t.tree, $name.tree, $params.tree, $code.text);
          setLocation($tree, $ASM);
      })
    ;


list_params returns[ListDeclParam tree]
@init {
    $tree = new ListDeclParam();
    setLocation($tree, $start);
}
    : (p1=param {
        assert($p1.tree != null);
        $tree.add($p1.tree);
        setLocation($tree,$p1.start);
    }
    (COMMA p2=param {
        assert($p2.tree != null);
        $tree.add($p2.tree);
        setLocation($tree,$p2.start);
    })*
    )?
    ;

    
multi_line_string returns[String text, Location location]
    : s=STRING {
            $text = $s.text;
            $location = tokenLocation($s);
        }
    | s=MULTI_LINE_STRING {
            $text = $s.text;
            $location = tokenLocation($s);
        }
    ;

param returns[AbstractDeclParam tree]
    : t=type i=ident {
        assert($t.tree != null);
        assert($i.tree != null);

        $tree = new DeclParam($t.tree, $i.tree);
        setLocation($tree, $t.start);
    }
    ;