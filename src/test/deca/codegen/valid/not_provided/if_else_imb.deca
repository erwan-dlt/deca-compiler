// Description:
//    Test avec des conditions imbriquées
//
// Resultats:
//    15

{
    int a = 10;
    int b = 5;
    int c;

    if (a > b) {
        if (a - b > 5) {
            c = a * b;
            println(c);
        } else {
            c = a + b;
            println(c);
        }
    } else {
        c = b - a;
        println(c);
    }
}
