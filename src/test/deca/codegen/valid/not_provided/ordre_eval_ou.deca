// Description:
//    Test de l'ordre d'évaluation dans des 
//    expressions booléennes (ou)
//
// Resultats:
//    b = 0 
//
// comme on évalue seulement la première condition (vraie)
// dans le ||, on n'incrémente pas b donc b toujours égal à 0

{
    int a = 0;
    int b = 0;
    if (a == 0 || (b = b+1) == 1){
        println("b = ", b); 
    }
    else {
        println("Erreur : a = 0");
    }
}